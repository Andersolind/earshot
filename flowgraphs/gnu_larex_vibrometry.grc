- name: epy_infra_sonifier
  id: epy_block
  parameters:
    _source_code: |
      import os
      import sys
      from pathlib import Path
      import numpy as np
      from gnuradio import gr

      for _cand in [
          os.environ.get("GNU_LAREX_ROOT", ""),
          str(Path.cwd()),
          str(Path.cwd().parent),
          r"C:\Users\Anders\Documents\Clients\GNU-Larex",
      ]:
          if _cand and (Path(_cand) / "src" / "larex_dsp.py").exists() and _cand not in sys.path:
              sys.path.insert(0, _cand)

      from src.larex_dsp import InfrasonicSonifierCore


      class blk(gr.sync_block):
          def __init__(self, samp_rate=48000.0, carrier_hz=168.0, vad_thresh_db=-42.0):
              gr.sync_block.__init__(
                  self,
                  name="Infrasonic Breathing Sonifier & VAD",
                  in_sig=[np.float32, np.float32],
                  out_sig=[np.float32, np.float32],
              )
              self._core = InfrasonicSonifierCore(
                  samp_rate=samp_rate,
                  carrier_hz=carrier_hz,
                  vad_thresh_db=vad_thresh_db,
              )
              self.samp_rate = samp_rate
              self.carrier_hz = carrier_hz
              self.vad_thresh_db = vad_thresh_db

          @property
          def carrier_hz(self):
              return self._core.carrier_hz

          @carrier_hz.setter
          def carrier_hz(self, val):
              self._core.carrier_hz = float(val)

          @property
          def vad_thresh_db(self):
              return self._core.vad_thresh_db

          @vad_thresh_db.setter
          def vad_thresh_db(self, val):
              self._core.vad_thresh_db = float(val)

          def work(self, input_items, output_items):
              sonified, vad = self._core.process(input_items[0], input_items[1])
              output_items[0][:] = sonified
              output_items[1][:] = vad
              return len(output_items[0])
    affinity: ''
    alias: ''
    carrier_hz: breath_carrier_hz
    comment: 'FM/AM warm breathing sonifier + Subvoc VAD'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: baseband_rate
    vad_thresh_db: gate_thresh_db
  states:
    _io_cache: ('Infrasonic Breathing Sonifier & VAD', 'blk', [('samp_rate', '48000.0'), ('carrier_hz', '168.0'), ('vad_thresh_db', '-42.0')], [('0', 'float', 1), ('1', 'float', 1)], [('0', 'float', 1), ('1', 'float', 1)], '', ['carrier_hz', 'samp_rate', 'vad_thresh_db'])
