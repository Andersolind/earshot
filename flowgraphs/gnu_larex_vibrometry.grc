options:
  parameters:
    author: GNU-Larex DSP Suite
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: 'Ultimate RF Micro-Doppler Vibrometry, Subvocalization & Respiration Flowgraph'
    copyright: ''
    description: 'Captures chest breathing & laryngeal subvocalization micro-displacements via SDR RF Doppler (or built-in physiological radar simulator), performs clutter circle-center calibration, continuous arctan phase unwrapping (um), STFT spectral gating, infrasonic-to-audible sonification, BPM tracking, and 4-channel WAV recording.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: gnu_larex_vibrometry_grc
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'GNU-Larex: RF Vibrometry, Subvocalization & Respiration Suite'
    window_size: (1680,1040)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 16.0]
    rotation: 0
    state: enabled

