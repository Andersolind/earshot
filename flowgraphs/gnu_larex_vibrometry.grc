- name: epy_master_out
  id: epy_block
  parameters:
    _source_code: |
      import os
      import sys
      from pathlib import Path
      import numpy as np
      from gnuradio import gr

      _root = None
      for _cand in [
          os.environ.get("GNU_LAREX_ROOT", ""),
          str(Path.cwd()),
          str(Path.cwd().parent),
          r"C:\Users\Anders\Documents\Clients\GNU-Larex",
      ]:
          if _cand and (Path(_cand) / "src" / "larex_dsp.py").exists():
              _root = _cand
              if _cand not in sys.path:
                  sys.path.insert(0, _cand)
              break

      from src.larex_dsp import MasterExperienceOutputCore


      class blk(gr.sync_block):
          def __init__(
              self,
              samp_rate=48000.0,
              audio_mix_mode=0,
              breath_mix_gain=0.45,
              record_enable=False,
          ):
              gr.sync_block.__init__(
                  self,
                  name="Stereo Experience Matrix & 4-Ch Recorder",
                  in_sig=[np.float32, np.float32, np.float32, np.float32],
                  out_sig=[np.float32, np.float32],
              )
              rec_dir = str(Path(_root) / "recordings") if _root else "recordings"
              self._core = MasterExperienceOutputCore(
                  samp_rate=samp_rate,
                  audio_mix_mode=audio_mix_mode,
                  breath_mix_gain=breath_mix_gain,
                  record_enable=record_enable,
                  recordings_dir=rec_dir,
              )
              self.samp_rate = samp_rate
              self.audio_mix_mode = audio_mix_mode
              self.breath_mix_gain = breath_mix_gain
              self.record_enable = record_enable

          @property
          def audio_mix_mode(self):
              return self._core.audio_mix_mode

          @audio_mix_mode.setter
          def audio_mix_mode(self, val):
              self._core.audio_mix_mode = int(val)

          @property
          def breath_mix_gain(self):
              return self._core.breath_mix_gain

          @breath_mix_gain.setter
          def breath_mix_gain(self, val):
              self._core.breath_mix_gain = float(val)

          @property
          def record_enable(self):
              return self._core.record_enable

          @record_enable.setter
          def record_enable(self, val):
              self._core.record_enable = bool(val)

          def stop(self):
              self._core.close()
              return True

          def work(self, input_items, output_items):
              l_out, r_out = self._core.process(
                  input_items[0],
                  input_items[1],
                  input_items[2],
                  input_items[3],
              )
              output_items[0][:] = l_out
              output_items[1][:] = r_out
              return len(output_items[0])
    affinity: ''
    alias: ''
    audio_mix_mode: audio_mix_mode
    breath_mix_gain: breath_mix_gain
    comment: '4-Mode Headphone Mixer & 4-Ch WAV/CSV Logger'
    maxoutbuf: '0'
    minoutbuf: '0'
    record_enable: record_enable
    samp_rate: baseband_rate
  states:
    _io_cache: ('Stereo Experience Matrix & 4-Ch Recorder', 'blk', [('samp_rate', '48000.0'), ('audio_mix_mode', '0'), ('breath_mix_gain', '0.45'), ('record_enable', 'False')], [('0', 'float', 1), ('1', 'float', 1), ('2', 'float', 1), ('3', 'float', 1)], [('0', 'float', 1), ('1', 'float', 1)], '', ['audio_mix_mode', 'breath_mix_gain', 'record_enable', 'samp_rate'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1520, 512.0]
    rotation: 0
    state: enabled

