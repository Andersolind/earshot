- name: epy_iq_clutter
  id: epy_block
  parameters:
    _source_code: |
      import os
      import sys
      from pathlib import Path
      import numpy as np
      from gnuradio import gr

      for _cand in [
          os.environ.get("GNU_LAREX_ROOT", ""),
          str(Path.cwd()),
          str(Path.cwd().parent),
          r"C:\Users\Anders\Documents\Clients\GNU-Larex",
      ]:
          if _cand and (Path(_cand) / "src" / "larex_dsp.py").exists() and _cand not in sys.path:
              sys.path.insert(0, _cand)

      from src.larex_dsp import IQClutterCancellerCore


      class blk(gr.sync_block):
          def __init__(self, alpha=0.005, mode=0):
              gr.sync_block.__init__(
                  self,
                  name="Adaptive I/Q Clutter & Circle Canceller",
                  in_sig=[np.complex64],
                  out_sig=[np.complex64],
              )
              self._core = IQClutterCancellerCore(alpha=alpha, mode=mode)
              self.alpha = alpha
              self.mode = mode

          @property
          def alpha(self):
              return self._core.alpha

          @alpha.setter
          def alpha(self, val):
              self._core.alpha = float(val)

          @property
          def mode(self):
              return self._core.mode

          @mode.setter
          def mode(self, val):
              self._core.mode = int(val)

          def work(self, input_items, output_items):
              output_items[0][:] = self._core.process(input_items[0])
              return len(output_items[0])
    affinity: ''
    alias: ''
    alpha: '0.005'
    comment: 'Centers radar arc & removes TX-RX leakage'
    maxoutbuf: '0'
    minoutbuf: '0'
    mode: clutter_mode
  states:
    _io_cache: ('Adaptive I/Q Clutter & Circle Canceller', 'blk', [('alpha', '0.005'), ('mode', '0')], [('0', 'complex', 1)], [('0', 'complex', 1)], '', ['alpha', 'mode'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [496, 384.0]
