- name: epy_radar_src
  id: epy_block
  parameters:
    _source_code: |
      import os
      import sys
      from pathlib import Path
      import numpy as np
      from gnuradio import gr

      for _cand in [
          os.environ.get("GNU_LAREX_ROOT", ""),
          str(Path.cwd()),
          str(Path.cwd().parent),
          r"C:\Users\Anders\Documents\Clients\GNU-Larex",
      ]:
          if _cand and (Path(_cand) / "src" / "larex_dsp.py").exists() and _cand not in sys.path:
              sys.path.insert(0, _cand)

      from src.larex_dsp import HybridSDRRadarSource


      class blk(HybridSDRRadarSource):
          def __init__(
              self,
              rf_samp_rate=960000.0,
              baseband_rate=48000.0,
              rf_freq_mhz=915.0,
              rf_gain=35.0,
              source_mode=0,
              sdr_args="",
              enable_cw_tx=False,
          ):
              super().__init__(
                  rf_samp_rate=rf_samp_rate,
                  baseband_rate=baseband_rate,
                  rf_freq_mhz=rf_freq_mhz,
                  rf_gain=rf_gain,
                  source_mode=source_mode,
                  sdr_args=sdr_args,
                  enable_cw_tx=enable_cw_tx,
              )

          @property
          def source_mode(self):
              return self._source_mode_val

          @source_mode.setter
          def source_mode(self, val):
              self._source_mode_val = int(val)
              self._sdr_attempted = False

          @property
          def rf_freq_mhz(self):
              return self._rf_freq_val

          @rf_freq_mhz.setter
          def rf_freq_mhz(self, val):
              self._rf_freq_val = float(val)
              if hasattr(self, "_sim"):
                  self._sim.rf_freq_mhz = self._rf_freq_val
              if getattr(self, "_sdr", None) is not None:
                  try:
                      from SoapySDR import SOAPY_SDR_RX, SOAPY_SDR_TX
                      self._sdr.setFrequency(SOAPY_SDR_RX, 0, self._rf_freq_val * 1e6)
                      if self._tx_stream is not None:
                          self._sdr.setFrequency(SOAPY_SDR_TX, 0, self._rf_freq_val * 1e6)
                  except Exception:
                      pass

          @property
          def rf_gain(self):
              return self._rf_gain_val

          @rf_gain.setter
          def rf_gain(self, val):
              self._rf_gain_val = float(val)
              if getattr(self, "_sdr", None) is not None:
                  try:
                      from SoapySDR import SOAPY_SDR_RX
                      self._sdr.setGain(SOAPY_SDR_RX, 0, self._rf_gain_val)
                  except Exception:
                      pass
    affinity: ''
    alias: ''
    baseband_rate: baseband_rate
    comment: 'SoapySDR Hardware OR Physiological Radar Sim'
    enable_cw_tx: 'False'
    maxoutbuf: '0'
    minoutbuf: '0'
    rf_freq_mhz: rf_freq_mhz
    rf_gain: rf_gain
    rf_samp_rate: rf_samp_rate
    sdr_args: '""'
    source_mode: source_mode
  states:
    _io_cache: ('Hybrid SDR / Radar Vibrometry Source', 'blk', [('rf_samp_rate', '960000.0'), ('baseband_rate', '48000.0'), ('rf_freq_mhz', '915.0'), ('rf_gain', '35.0'), ('source_mode', '0'), ('sdr_args', "''"), ('enable_cw_tx', 'False')], [], [('0', 'complex', 1)], '', ['baseband_rate', 'enable_cw_tx', 'rf_freq_mhz', 'rf_gain', 'rf_samp_rate', 'sdr_args', 'source_mode'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 360.0]
    rotation: 0
    state: enabled

